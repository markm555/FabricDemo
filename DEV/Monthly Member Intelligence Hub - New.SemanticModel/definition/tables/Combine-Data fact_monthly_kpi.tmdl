		dataType: string
		lineageTag: b3023cbd-a039-434b-883e-22befcf92553
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = Automatic

	column LoansBooked
		dataType: int64
		formatString: 0
		lineageTag: d10b5646-0e7f-49ae-8d2d-116f561b8b1c
		summarizeBy: sum
		sourceColumn: LoansBooked

		annotation SummarizationSetBy = Automatic

	column DepositGrowthPct
		dataType: double
		lineageTag: 5dc3e0c3-b503-4536-9ae6-38a8906c239f
		summarizeBy: sum
		sourceColumn: DepositGrowthPct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

