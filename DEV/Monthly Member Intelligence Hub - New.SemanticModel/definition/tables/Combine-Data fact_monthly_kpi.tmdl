		summarizeBy: sum
		sourceColumn: NPS

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column DelinquencyRatePct
		dataType: double
		lineageTag: d64fb355-95f6-4edc-a213-f6fe27f0c066
		summarizeBy: sum
		sourceColumn: DelinquencyRatePct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column DigitalAdoptionPct
		dataType: double
		lineageTag: 70dece0d-7427-4957-8761-5e84783f83c6
		summarizeBy: sum
		sourceColumn: DigitalAdoptionPct

		annotation SummarizationSetBy = Automatic

