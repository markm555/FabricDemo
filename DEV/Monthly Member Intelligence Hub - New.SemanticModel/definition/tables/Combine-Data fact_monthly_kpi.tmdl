		summarizeBy: none
		sourceColumn: MonthStart

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column BranchId
		dataType: string
		lineageTag: 251e3238-93cf-430e-a118-f55b9fc0eac3
		summarizeBy: none
		sourceColumn: BranchId

		annotation SummarizationSetBy = Automatic

