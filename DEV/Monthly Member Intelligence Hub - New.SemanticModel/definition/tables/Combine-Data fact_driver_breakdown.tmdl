	/// Readable driver name for reports and Copilot.
	column Driver =
			SWITCH ( 'Combine-Data fact_driver_breakdown'[DriverName],
			    "CrossSellRate", "Cross-sell rate",
			    "MemberGrowth", "Member growth",
			    "StaffingCoverage", "Staffing coverage",
			    "LocalEconomicIndex", "Local economic index",
			    "CallCenterWaitTime", "Call center wait time",
			    "MobileAppStability", "Mobile app stability",
			    'Combine-Data fact_driver_breakdown'[DriverName] )
		dataType: string
		lineageTag: 1646d9eb-6036-485e-bd22-08272883a437
		summarizeBy: none

