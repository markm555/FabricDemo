table 'Combine-Data fact_driver_breakdown'
	lineageTag: 786a332e-64a3-4905-8236-8fe576ac4b0e

	/// Total impact score of operational drivers on member outcomes. Positive helps, negative hurts.
	measure 'Driver Impact' = SUM('Combine-Data fact_driver_breakdown'[ImpactScore])
		formatString: 0.0
		displayFolder: Drivers
		lineageTag: 708ce757-3a47-4ba3-8c95-4858f781c0d0

	/// Average monthly value of the operational driver.
	measure 'Avg Driver Value' = AVERAGE ( 'Combine-Data fact_driver_breakdown'[DriverValue] )
		formatString: #,0.0
		displayFolder: Drivers
		lineageTag: e244c2c3-f8a5-49e3-bedb-f1324a0c947f

	/// Red for drivers hurting member outcomes, green for drivers helping.
	measure 'Impact Bar Color' = IF ( [Driver Impact] < 0, "#C0392B", "#2E8B57" )
		displayFolder: Formatting
		lineageTag: bcd09b3e-e3e3-4019-be4d-7771108545f6

