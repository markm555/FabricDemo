table 'Combine-Data dim_branch'
	lineageTag: b92a602f-bcc8-490c-a4e7-642b0d941843

	measure 'Stress Calc 1' = ```
			
			SUMX(
			    GENERATESERIES(1, 5000, 1),
			    [Avg NPS] + [Delinquency %] + [Digital Adoption %]
			)
			
			
			```
		lineageTag: 74025f07-ef1a-40c4-9a9a-dafa971505e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stress Calc 2' =
			
			SUMX(
			    CROSSJOIN(
			        VALUES('Combine-Data dim_branch'[BranchName]),
			        VALUES('Combine-Data dim_month'[MonthStart])
			    ),
			    [Stress Calc 1]
			)
		lineageTag: 4fdb7649-f27a-41c7-918c-a08ffd61a210

		annotation PBI_FormatHint = {"isGeneralNumber":true}

